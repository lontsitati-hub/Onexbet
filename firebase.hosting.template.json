{
  "public": "dist/client",
  "ignore": [
    "firebase.json",
    "**/.*",
    "**/node_modules/**"
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "**/*.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "_expo/static/**",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "data/club-logos-index.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/**",
      "run": {
        "serviceId": "<CLOUD_RUN_SERVICE_ID>",
        "region": "<CLOUD_RUN_REGION>"
      }
    },
    {
      "source": "/manus-storage/**",
      "run": {
        "serviceId": "<CLOUD_RUN_SERVICE_ID>",
        "region": "<CLOUD_RUN_REGION>"
      }
    },
    {
      "source": "**",
      "destination": "/index.html"
    }
  ]
}
